# Ollama Local AI Configuration (Required)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_API_KEY=

# Optional Dev Flag: Set to 'true' only during dev/testing when Ollama is unavailable
USE_MOCK_AI=false

# Supabase Server & Database Configuration (Required for database operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Public / Client-Safe Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
