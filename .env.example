# =============================================================================
# UniHack / InduIntel environment configuration (TEMPLATE ONLY - no real values)
# Copy to .env.local and fill in. NEVER commit .env.local or any real keys.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project URL from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# Server-side alias of the project URL (used by scripts)
SUPABASE_URL=your_supabase_project_url_here
# Service-role key (secret! server-only). Required for enrichment writes,
# persistent evidence cache, and exports.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Gemini ------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Python evidence service -------------------------------------------------
# Base URL of the running FastAPI service (services/evidence). Example:
#   http://127.0.0.1:8000
EVIDENCE_SERVICE_URL=your_evidence_service_url_here

# --- Search provider (consumed by services/evidence/search.py) ---------------
# A GET endpoint taking ?q=<query> returning {"results":[{"url","title"},...]}.
# Must be a REAL search API (e.g. SerpAPI/Bing/Custom Search JSON API proxy).
# Scraping search-engine HTML is NOT supported by design.
EVIDENCE_SEARCH_URL=your_search_provider_url_here
EVIDENCE_SEARCH_API_KEY=your_search_provider_api_key_here

# --- Misc --------------------------------------------------------------------
# Internal token protecting write endpoints
INTERNAL_API_TOKEN=your_internal_api_token_here
