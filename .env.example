# Google Gemini API Configuration (Server-Side Only - NEVER expose to browser)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Dev Flag: Set to 'true' to use mock provider when testing without Gemini API key
USE_MOCK_AI=false

# Supabase Server & Database Configuration (Required for database operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Public / Client-Safe Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
